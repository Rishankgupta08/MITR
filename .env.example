# MITR environment configuration
# Copy this file to .env and fill in the real values. NEVER commit .env.

# --- Django core ---
# Secret key. Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-secret-key

# Set to true only for local development. Defaults to false.
DEBUG=false

# Comma-separated list of hostnames allowed to serve this deployment.
# Include your domain, the VM IP, and localhost for dev.
# Set this to your Railway/Render domain after deploy
# Example: ALLOWED_HOSTS=mitr-production.up.railway.app
ALLOWED_HOSTS=mitr.example.com,34.131.30.126,localhost

# --- Database ---
# Format: <scheme>://<user>:<password>@<host>:<port>/<name>?sslmode=require
#   postgres://  -> PostgreSQL (production)
#   mysql://     -> MySQL
#   sqlite:///   -> local SQLite file
# Examples:
#   DATABASE_URL=postgres://mitr:changeme@db.internal:5432/mitr
#   DATABASE_URL=sqlite:///./database/db.sqlite3
DATABASE_URL=sqlite:///./database/db.sqlite3

# --- Email (Gmail SMTP) ---
# Use an "App Password" for Gmail accounts with 2FA enabled, not your regular password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=mitr.taskreminder@gmail.com
EMAIL_HOST_PASSWORD=change-me-to-gmail-app-password
DEFAULT_FROM_EMAIL=mitr.taskreminder@gmail.com

# --- Celery / Redis ---
# Redis broker and result backend (used by config/celery.py).
# Format: redis://[:password]@host:port/db
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0